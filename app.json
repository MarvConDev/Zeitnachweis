{
  "expo": {
    "name": "Zeitnachweis",
    "slug": "zeitnachweis",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.zeitnachweis.app",
      "buildNumber": "6"
    },
    "android": {
      "package": "de.zeitnachweis.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "fe7433eb-87cb-46cf-b15c-a57fd7aa36ab"
      }
    },
    "owner": "matvcondev"
  }
}
